# Public Firebase web config (safe to commit; gated by Firebase Auth rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side (set in Cloud Run env / local .env.local — never commit values)
GCP_PROJECT_ID=
GCS_PROTOTYPES_BUCKET=
PORTAL_HOST=protypic.ai              # host for portal + API
VIEW_HOST=view.protypic.ai           # origin-isolated host for prototype content
COOKIE_SECRET=                       # random string for HMAC of the unlock cookie; prod via Secret Manager
API_TOKEN_PEPPER=                    # random string, prod via Secret Manager
CRON_OIDC_AUDIENCE=                  # Cloud Run URL used by Cloud Scheduler

# Local dev only
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
STORAGE_EMULATOR_HOST=
